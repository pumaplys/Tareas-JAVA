{
  "$defs": {
    "AlignmentMethod": {
      "description": "De donde salieron los tiempos por palabra.",
      "enum": [
        "provider_alignment",
        "provider_normalized_alignment",
        "forced_alignment",
        "none"
      ],
      "title": "AlignmentMethod",
      "type": "string"
    },
    "AlignmentStatus": {
      "enum": [
        "ok",
        "missing",
        "rejected"
      ],
      "title": "AlignmentStatus",
      "type": "string"
    },
    "CueType": {
      "enum": [
        "sfx",
        "music"
      ],
      "title": "CueType",
      "type": "string"
    },
    "IssueSeverity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "SoundAssetRef": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "path": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "license_note": {
          "maxLength": 600,
          "minLength": 1,
          "title": "License Note",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "path",
        "sha256",
        "license_note"
      ],
      "title": "SoundAssetRef",
      "type": "object"
    },
    "SoundCue": {
      "additionalProperties": false,
      "description": "Posicion propuesta de un efecto o de la musica. La mezcla es del modulo 4.",
      "properties": {
        "cue_type": {
          "$ref": "#/$defs/CueType"
        },
        "scene_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        },
        "asset_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "gain_db": {
          "maximum": 0.0,
          "minimum": -60.0,
          "title": "Gain Db",
          "type": "number"
        }
      },
      "required": [
        "cue_type",
        "asset_id",
        "start_s",
        "end_s",
        "gain_db"
      ],
      "title": "SoundCue",
      "type": "object"
    },
    "VoiceControl": {
      "additionalProperties": false,
      "description": "Estado del manifiesto.\n\nUn manifiesto con CUALQUIER incidencia `blocking=True` nunca es `ready`.\nLa ausencia de un efecto opcional es informativa (`blocking=False`); los\ndefectos de duracion o de alineacion son bloqueantes.",
      "properties": {
        "voice_status": {
          "$ref": "#/$defs/VoiceStatus"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/VoiceIssue"
          },
          "maxItems": 200,
          "title": "Issues",
          "type": "array"
        },
        "admissible_for_assembly": {
          "description": "Resultado calculado. Un consumidor NO debe fiarse de este booleano: debe repetir la comprobacion sobre los archivos reales.",
          "title": "Admissible For Assembly",
          "type": "boolean"
        }
      },
      "required": [
        "voice_status",
        "admissible_for_assembly"
      ],
      "title": "VoiceControl",
      "type": "object"
    },
    "VoiceIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "scene_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        }
      },
      "required": [
        "code",
        "message",
        "severity",
        "blocking"
      ],
      "title": "VoiceIssue",
      "type": "object"
    },
    "VoiceMaster": {
      "additionalProperties": false,
      "description": "Pista completa de narracion, ya con las pausas del guion incluidas.",
      "properties": {
        "path": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "codec": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Codec",
          "type": "string"
        },
        "sample_rate_hz": {
          "maximum": 48000,
          "minimum": 8000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "channels": {
          "maximum": 2,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "sample_count": {
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        },
        "actual_duration_s": {
          "exclusiveMinimum": 0,
          "title": "Actual Duration S",
          "type": "number"
        }
      },
      "required": [
        "path",
        "sha256",
        "codec",
        "sample_rate_hz",
        "channels",
        "sample_count",
        "actual_duration_s"
      ],
      "title": "VoiceMaster",
      "type": "object"
    },
    "VoiceProviderInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Name",
          "type": "string"
        },
        "model_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "voice_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Voice Id",
          "type": "string"
        },
        "output_format": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Output Format",
          "type": "string"
        },
        "internal_format": {
          "description": "Formato interno al que se decodifica todo (decision del proyecto).",
          "maxLength": 200,
          "minLength": 1,
          "title": "Internal Format",
          "type": "string"
        },
        "effective_settings": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Parametros realmente enviados. Nunca contiene secretos.",
          "title": "Effective Settings",
          "type": "object"
        },
        "settings_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Settings Hash",
          "type": "string"
        },
        "processing_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Processing Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "model_id",
        "voice_id",
        "output_format",
        "internal_format",
        "settings_hash",
        "processing_version"
      ],
      "title": "VoiceProviderInfo",
      "type": "object"
    },
    "VoiceScene": {
      "additionalProperties": false,
      "description": "Tiempos medidos de una escena, en muestras y en segundos derivados.\n\n`end_sample` es extremo EXCLUSIVO. `clip_end_s` marca el final del habla,\nantes del silencio anadido; `end_s` incluye ese silencio.",
      "properties": {
        "scene_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Scene Id",
          "type": "string"
        },
        "order": {
          "maximum": 40,
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "source_text": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Source Text",
          "type": "string"
        },
        "source_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Text Sha256",
          "type": "string"
        },
        "clip_path": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Clip Path",
          "type": "string"
        },
        "clip_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Clip Sha256",
          "type": "string"
        },
        "clip_samples": {
          "minimum": 1,
          "title": "Clip Samples",
          "type": "integer"
        },
        "pause_samples": {
          "minimum": 0,
          "title": "Pause Samples",
          "type": "integer"
        },
        "start_sample": {
          "minimum": 0,
          "title": "Start Sample",
          "type": "integer"
        },
        "end_sample": {
          "minimum": 1,
          "title": "End Sample",
          "type": "integer"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "clip_end_s": {
          "exclusiveMinimum": 0,
          "title": "Clip End S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "actual_duration_s": {
          "exclusiveMinimum": 0,
          "title": "Actual Duration S",
          "type": "number"
        },
        "alignment_method": {
          "$ref": "#/$defs/AlignmentMethod"
        },
        "alignment_status": {
          "$ref": "#/$defs/AlignmentStatus"
        },
        "provider_normalized_text": {
          "anyOf": [
            {
              "maxLength": 600,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Texto normalizado del proveedor, si lo envio. NO sustituye al original.",
          "title": "Provider Normalized Text"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "characters_sent": {
          "minimum": 0,
          "title": "Characters Sent",
          "type": "integer"
        }
      },
      "required": [
        "scene_id",
        "order",
        "source_text",
        "source_text_sha256",
        "clip_path",
        "clip_sha256",
        "clip_samples",
        "pause_samples",
        "start_sample",
        "end_sample",
        "start_s",
        "clip_end_s",
        "end_s",
        "actual_duration_s",
        "alignment_method",
        "alignment_status",
        "characters_sent"
      ],
      "title": "VoiceScene",
      "type": "object"
    },
    "VoiceSound": {
      "additionalProperties": false,
      "properties": {
        "cues": {
          "items": {
            "$ref": "#/$defs/SoundCue"
          },
          "maxItems": 60,
          "title": "Cues",
          "type": "array"
        },
        "assets": {
          "description": "Solo los assets realmente usados, copiados junto al manifiesto.",
          "items": {
            "$ref": "#/$defs/SoundAssetRef"
          },
          "maxItems": 60,
          "title": "Assets",
          "type": "array"
        }
      },
      "title": "VoiceSound",
      "type": "object"
    },
    "VoiceSource": {
      "additionalProperties": false,
      "description": "Vinculo con el guion de entrada.\n\nEl hash comprueba la CORRESPONDENCIA entre archivos; no autentica a nadie.\nEl consumidor debe revalidar el guion, no limitarse a comparar hashes.",
      "properties": {
        "source_script_schema_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Script Schema Version",
          "type": "string"
        },
        "source_script_sha256": {
          "description": "SHA-256 de los bytes exactos del script.json leido.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Script Sha256",
          "type": "string"
        },
        "source_profile_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Source Profile Id",
          "type": "string"
        },
        "source_channel": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Source Channel",
          "type": "string"
        },
        "source_simulation": {
          "title": "Source Simulation",
          "type": "boolean"
        },
        "source_production_status": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Source Production Status",
          "type": "string"
        }
      },
      "required": [
        "source_script_schema_version",
        "source_script_sha256",
        "source_profile_id",
        "source_channel",
        "source_simulation",
        "source_production_status"
      ],
      "title": "VoiceSource",
      "type": "object"
    },
    "VoiceStatus": {
      "enum": [
        "ready",
        "needs_review"
      ],
      "title": "VoiceStatus",
      "type": "string"
    },
    "VoiceUsage": {
      "additionalProperties": false,
      "description": "Uso contado LOCALMENTE. No es facturacion observada.\n\n`requests_total` cubre todo el historial del trabajo; `requests_this_run`\nsolo esta invocacion, de modo que reutilizar un resultado muestre cero\nsolicitudes nuevas sin perder el total.",
      "properties": {
        "requests_total": {
          "minimum": 0,
          "title": "Requests Total",
          "type": "integer"
        },
        "requests_this_run": {
          "minimum": 0,
          "title": "Requests This Run",
          "type": "integer"
        },
        "characters_sent_total": {
          "minimum": 0,
          "title": "Characters Sent Total",
          "type": "integer"
        },
        "characters_sent_this_run": {
          "minimum": 0,
          "title": "Characters Sent This Run",
          "type": "integer"
        },
        "request_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Request Ids",
          "type": "array"
        },
        "latency_ms_total": {
          "minimum": 0,
          "title": "Latency Ms Total",
          "type": "integer"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null si no hay tarifa configurada o si hubo consumo desconocido.",
          "title": "Estimated Cost Usd"
        },
        "billing_observed": {
          "default": false,
          "description": "False: el proveedor no ha confirmado facturacion por esta via.",
          "title": "Billing Observed",
          "type": "boolean"
        }
      },
      "required": [
        "requests_total",
        "requests_this_run",
        "characters_sent_total",
        "characters_sent_this_run",
        "latency_ms_total"
      ],
      "title": "VoiceUsage",
      "type": "object"
    },
    "VoiceWord": {
      "additionalProperties": false,
      "description": "Palabra narrada con tiempos GLOBALES respecto de narration.wav.\n\n`char_start` es inclusivo y `char_end` exclusivo, en puntos de codigo de\nPython sobre el `narration_text` original de la escena (no en bytes UTF-8).",
      "properties": {
        "scene_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Scene Id",
          "type": "string"
        },
        "word_index": {
          "description": "Indice desde cero dentro de la escena.",
          "minimum": 0,
          "title": "Word Index",
          "type": "integer"
        },
        "text": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "minimum": 1,
          "title": "Char End",
          "type": "integer"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "minimum": 0,
          "title": "End S",
          "type": "number"
        },
        "emphasis": {
          "title": "Emphasis",
          "type": "boolean"
        }
      },
      "required": [
        "scene_id",
        "word_index",
        "text",
        "char_start",
        "char_end",
        "start_s",
        "end_s",
        "emphasis"
      ],
      "title": "VoiceWord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Manifiesto lateral de voz del modulo 2. Fuente de tiempos medidos para los modulos 3 y 4. schema_version=1.0.",
  "properties": {
    "document_type": {
      "const": "voice_manifest",
      "default": "voice_manifest",
      "title": "Document Type",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "voice_run_id": {
      "pattern": "^[0-9a-f\\-]{36}$",
      "title": "Voice Run Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[0-9a-f\\-]{36}$",
      "title": "Job Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "simulation": {
      "title": "Simulation",
      "type": "boolean"
    },
    "source": {
      "$ref": "#/$defs/VoiceSource"
    },
    "provider": {
      "$ref": "#/$defs/VoiceProviderInfo"
    },
    "control": {
      "$ref": "#/$defs/VoiceControl"
    },
    "master": {
      "$ref": "#/$defs/VoiceMaster"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/VoiceScene"
      },
      "maxItems": 40,
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "words": {
      "items": {
        "$ref": "#/$defs/VoiceWord"
      },
      "maxItems": 4000,
      "title": "Words",
      "type": "array"
    },
    "sound": {
      "$ref": "#/$defs/VoiceSound"
    },
    "usage": {
      "$ref": "#/$defs/VoiceUsage"
    }
  },
  "required": [
    "voice_run_id",
    "job_id",
    "created_at",
    "simulation",
    "source",
    "provider",
    "control",
    "master",
    "scenes",
    "sound",
    "usage"
  ],
  "title": "viralgen voice manifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
