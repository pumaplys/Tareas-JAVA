        "start_sample": {
          "minimum": 0,
          "title": "Start Sample",
          "type": "integer"
        },
        "end_sample": {
          "minimum": 1,
          "title": "End Sample",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "minimum": 1,
          "title": "End Frame",
          "type": "integer"
        },
        "frames": {
