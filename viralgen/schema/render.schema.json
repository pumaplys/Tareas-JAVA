    "SegmentInfo": {
      "additionalProperties": false,
      "description": "Un segmento visual ya validado. Su archivo puede haberse limpiado.",
      "properties": {
        "scene_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_\\-]*$",
          "title": "Scene Id",
          "type": "string"
        },
        "order": {
          "maximum": 40,
          "minimum": 1,
