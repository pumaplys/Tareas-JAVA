      ],
      "title": "RenderStatus",
      "type": "string"
    },
    "RenderTimelineInfo": {
      "additionalProperties": false,
      "description": "Reloj de voz, reloj de video y el exceso de cuantizacion entre ambos.",
      "properties": {
        "sample_rate_hz": {
          "maximum": 48000,
          "minimum": 8000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "sample_count": {
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        },
        "narration_duration_s": {
          "description": "N/S. Reloj de VOZ.",
          "exclusiveMinimum": 0,
          "title": "Narration Duration S",
          "type": "number"
        },
        "narration_source": {
          "const": "source_manifest",
          "default": "source_manifest",
          "title": "Narration Source",
          "type": "string"
        },
        "fps": {
          "maximum": 120,
          "minimum": 1,
          "title": "Fps",
          "type": "integer"
        },
        "total_frames": {
          "minimum": 1,
          "title": "Total Frames",
          "type": "integer"
        },
        "visual_duration_s": {
          "description": "total_frames/F. Reloj de VIDEO.",
          "exclusiveMinimum": 0,
          "title": "Visual Duration S",
          "type": "number"
        },
        "quantization_excess_s": {
          "description": "visual_duration_s - narration_duration_s. Siempre < 1/F.",
          "minimum": 0,
          "title": "Quantization Excess S",
          "type": "number"
        },
        "max_frame_hold_s": {
          "description": "1/F. Es lo unico que se permite sostener de la ultima muestra visual al cerrar el fotograma final; nunca sirve para alargar un clip corto.",
          "exclusiveMinimum": 0,
          "title": "Max Frame Hold S",
          "type": "number"
        },
        "target_source": {
          "const": "montage_decision",
          "default": "montage_decision",
          "title": "Target Source",
          "type": "string"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/SceneBoundary"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        }
      },
      "required": [
        "sample_rate_hz",
        "sample_count",
        "narration_duration_s",
        "fps",
        "total_frames",
        "visual_duration_s",
        "quantization_excess_s",
        "max_frame_hold_s",
        "scenes"
      ],
      "title": "RenderTimelineInfo",
      "type": "object"
    },
    "ResampleInfo": {
      "additionalProperties": false,
      "properties": {
        "source_rate_hz": {
          "maximum": 192000,
          "minimum": 8000,
          "title": "Source Rate Hz",
          "type": "integer"
        },
        "target_rate_hz": {
          "maximum": 192000,
          "minimum": 8000,
          "title": "Target Rate Hz",
