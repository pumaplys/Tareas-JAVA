# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repositorio.
# Todos los valores son opcionales salvo los marcados como obligatorios en modo real.

# --- Proveedor (obligatorio solo en modo real, es decir, sin --mock) ---
# Clave de API de OpenAI. En modo --mock no se lee ni se necesita.
OPENAI_API_KEY=
# Identificador EXACTO del modelo que vas a usar. Debe admitir Structured Outputs
# (Responses API + json_schema estricto). No hay valor por defecto a proposito:
# el proyecto no inventa nombres de modelo ni los cambia silenciosamente.
OPENAI_MODEL=

# --- Rutas y registro ---
# Directorio raiz de datos (SQLite, exportaciones, logs). Por defecto: ./.viralgen
VIRALGEN_DATA_DIR=./.viralgen
# DEBUG | INFO | WARNING | ERROR
VIRALGEN_LOG_LEVEL=INFO

# --- Limites por peticion y por trabajo ---
VIRALGEN_REQUEST_TIMEOUT_SECONDS=60
VIRALGEN_MAX_CALLS_PER_JOB=6
VIRALGEN_MAX_TRANSPORT_RETRIES=2
VIRALGEN_MAX_OUTPUT_TOKENS=6000

# --- Disco ---
VIRALGEN_MIN_FREE_DISK_MB=1500

# --- Seleccion de ideas ---
VIRALGEN_DUPLICATE_SIMILARITY_THRESHOLD=0.80
VIRALGEN_HISTORY_LOOKBACK_DAYS=90
VIRALGEN_HISTORY_MAX_ITEMS=30
VIRALGEN_IDEAS_PER_BATCH=5

# --- Parametros de muestreo (solo si tu modelo los admite) ---
# Si es false (por defecto) NUNCA se envia temperature al proveedor.
VIRALGEN_SEND_TEMPERATURE=false
VIRALGEN_TEMPERATURE=

# --- Tarifas para estimar coste (USD por 1.000.000 de tokens) ---
# Si faltan, estimated_cost_usd sera null. No se inventan precios.
VIRALGEN_PRICE_INPUT_PER_1M_USD=
VIRALGEN_PRICE_OUTPUT_PER_1M_USD=

# --- Catalogos y perfiles propios (opcional: por defecto usa los empaquetados) ---
VIRALGEN_PROFILES_PATH=
VIRALGEN_SERIES_BIBLE_PATH=

# ==========================================================================
# MODULO 2: VOZ (ElevenLabs)
# ==========================================================================
# Independientes de las de OpenAI: generar voz sobre un guion que YA existe no
# necesita OPENAI_API_KEY ni OPENAI_MODEL.

# Obligatorias en modo real (sin --mock).
ELEVENLABS_API_KEY=
# Identificador EXACTO del modelo. Punto de partida compatible con la
# referencia consultada: eleven_multilingual_v2. No hay valor por defecto: el
# modelo no se cambia en silencio.
ELEVENLABS_MODEL_ID=
# voice_id global. Alternativa: rellenar `voice_id` por perfil en
# src/viralgen/voice/data/voice_profiles.json. Los identificadores de voz los
# aporta TU cuenta: el proyecto no inventa ninguno.
ELEVENLABS_VOICE_ID=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# --- Formatos ---
# Lo que se pide al proveedor; se decodifica despues con FFmpeg.
VIRALGEN_VOICE_OUTPUT_FORMAT=mp3_44100_128
# Formato interno del proyecto (decision fija, registrada en el manifiesto).
VIRALGEN_VOICE_SAMPLE_RATE_HZ=24000
VIRALGEN_VOICE_CHANNELS=1
VIRALGEN_VOICE_SAMPLE_WIDTH_BYTES=2
VIRALGEN_FFMPEG_PATH=ffmpeg
VIRALGEN_FFMPEG_TIMEOUT_SECONDS=120

# --- Limites (unidades explicitas) ---
# Peticiones por TRABAJO de voz, no por proceso. Reintentos y alineaciones
# forzadas cuentan tambien.
VIRALGEN_VOICE_MAX_REQUESTS_PER_JOB=24
VIRALGEN_VOICE_MAX_TRANSPORT_RETRIES=2
VIRALGEN_VOICE_REQUEST_TIMEOUT_SECONDS=60
# Caracteres por peticion.
VIRALGEN_VOICE_MAX_REQUEST_CHARS=2500
# Bytes por respuesta HTTP (10 MiB).
VIRALGEN_VOICE_MAX_RESPONSE_BYTES=10485760
# MiB por trabajo de voz.
VIRALGEN_VOICE_MAX_JOB_STORAGE_MB=250

# --- Alineacion ---
# Tolerancia de redondeo temporal, en milisegundos.
VIRALGEN_VOICE_ALIGNMENT_TOLERANCE_MS=20
# Alineacion forzada sobre el WAV ya sintetizado. Cuenta contra el mismo
# presupuesto y NO regenera la voz. Desactivada por defecto.
VIRALGEN_VOICE_ALLOW_FORCED_ALIGNMENT=false

# --- Sonido opcional (desactivado hasta tener assets utilizables) ---
VIRALGEN_VOICE_ENABLE_SFX=false
VIRALGEN_VOICE_ENABLE_MUSIC=false
VIRALGEN_SOUND_ASSETS_PATH=
VIRALGEN_VOICE_PROFILES_PATH=

# --- Tarifa de voz (USD por 1000 caracteres enviados) ---
# Sin tarifa, estimated_cost_usd sera null. No se inventan precios.
VIRALGEN_PRICE_VOICE_PER_1K_CHARS_USD=

# ==========================================================================
# MODULO 3: MEDIOS VISUALES (OpenAI Images + Runway)
# ==========================================================================
# Independientes de las anteriores: generar visuales sobre un guion y una voz
# que YA existen no necesita ELEVENLABS_API_KEY. Un trabajo SOLO DE IMAGENES
# no necesita ninguna variable de Runway.

# --- Imagenes (obligatorias en modo real, sin --mock) ---
# Reutiliza OPENAI_API_KEY de la seccion del modulo 1.
# Modelo de IMAGENES. Es independiente de OPENAI_MODEL (que genera el guion):
# un modelo de texto no sirve para imagenes y el proyecto no lo sustituye en
# silencio. No hay valor por defecto. Referencia consultada: gpt-image-1.
OPENAI_IMAGE_MODEL=

# --- Clips (solo si el guion tiene escenas asset_type=video) ---
# El secreto de Runway viaja en la cabecera Authorization: Bearer <secreto>.
RUNWAYML_API_SECRET=
# Identificador EXACTO del modelo. Referencia consultada: gen4_turbo.
RUNWAY_MODEL=
RUNWAY_BASE_URL=https://api.dev.runwayml.com
# Cabecera X-Runway-Version. Queda registrada en la procedencia del manifiesto.
RUNWAY_API_VERSION=2024-11-06

# --- Presupuestos del TRABAJO (decisiones del proyecto, no del proveedor) ---
# Se cuentan por trabajo y se persisten: reiniciar el proceso no los reinicia.
# Intentos de creacion (imagenes + clips), incluidos los reintentos seguros.
VIRALGEN_MEDIA_MAX_GENERATION_ATTEMPTS=24
# Escenas de video permitidas por trabajo.
VIRALGEN_MEDIA_MAX_VIDEO_SCENES=2
# Segundos de video reservados, sumando la duracion SOLICITADA de cada intento.
VIRALGEN_MEDIA_MAX_VIDEO_SECONDS=20
# Reintentos ante errores seguros de reintentar (nunca ante outcome_unknown).
VIRALGEN_MEDIA_MAX_SAFE_RETRIES=2
# Consultas de estado de tareas asincronas, por trabajo.
VIRALGEN_MEDIA_MAX_STATUS_REQUESTS=120
# Descargas del archivo final, por trabajo.
VIRALGEN_MEDIA_MAX_DOWNLOAD_ATTEMPTS=3

# --- Tiempos (segundos) ---
# Espera local por invocacion antes de devolver waiting_remote y salir.
VIRALGEN_MEDIA_POLL_WAIT_S=60
# Intervalo minimo entre consultas de estado. No se baja de 5 s.
VIRALGEN_MEDIA_POLL_INTERVAL_S=5
VIRALGEN_MEDIA_IMAGE_TIMEOUT_S=180
VIRALGEN_MEDIA_HTTP_TIMEOUT_S=60
VIRALGEN_MEDIA_STATUS_TIMEOUT_S=20

# --- Tamanos (MiB salvo donde se indique) ---
# Respuesta de imagen ANTES de decodificar base64.
VIRALGEN_MEDIA_MAX_IMAGE_RESPONSE_MIB=32
VIRALGEN_MEDIA_MAX_VIDEO_FILE_MIB=100
# Tamano total del trabajo, incluidos temporales y derivados.
VIRALGEN_MEDIA_MAX_JOB_MIB=500
# Limite global de la cache de assets compartida entre trabajos.
VIRALGEN_MEDIA_CACHE_MAX_MIB=1024
# Bytes de la data URI YA CODIFICADA que se envia a Runway (limite propio).
VIRALGEN_MEDIA_DATA_URI_MAX_BYTES=4000000
# Pixeles descomprimidos maximos al abrir una imagen (proteccion local).
VIRALGEN_MEDIA_MAX_IMAGE_PIXELS=40000000
# Caracteres del prompt efectivo enviado al proveedor.
VIRALGEN_MEDIA_MAX_PROMPT_CHARS=4000

# --- Presentacion y geometria ---
# Calidad pedida al proveedor: low | medium | high | auto.
VIRALGEN_MEDIA_IMAGE_QUALITY=medium
# Formato pedido al proveedor: png | jpeg | webp.
VIRALGEN_MEDIA_IMAGE_FORMAT=jpeg
# Adaptacion al encuadre vertical: contain (relleno lateral) o crop (recorte).
# NUNCA se deforma la imagen: no hay opcion de estirado.
VIRALGEN_MEDIA_GEOMETRY_POLICY=contain
# Version del conjunto de referencias de personaje. Vacio = se deriva de la
# biblia de serie, de forma que un cambio de descripcion crea una version nueva
# en vez de reutilizar referencias que ya no corresponden.
VIRALGEN_MEDIA_REFERENCE_SET_VERSION=
# Referencias IMPORTADAS (archivo JSON con procedencia declarada). Las imagenes
# de terceros se importan con derechos declarados; el proyecto no las descarga.
VIRALGEN_MEDIA_REFERENCE_PACK_PATH=

# --- Medicion de video ---
# Solo se usa para MEDIR clips ya descargados; no transcodifica ni monta.
VIRALGEN_FFPROBE_PATH=ffprobe

# --- Tarifas (USD). Sin tarifa, estimated_cost_usd sera null ---
# No se inventan precios: se dejan vacias hasta conocer las reales.
VIRALGEN_PRICE_IMAGE_PER_UNIT_USD=
VIRALGEN_PRICE_VIDEO_PER_SECOND_USD=
